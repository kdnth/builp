# Copy this file to .env and fill in real values.

# Postgres connection string. Get this from the Neon console. A plain
# postgresql:// URL is fine; the app rewrites it to use psycopg3.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Frontend origin(s) allowed to call this API. JSON array of strings.
CORS_ORIGINS=["http://localhost:5173"]

# Neon Auth (Better Auth). Set after Neon Auth is turned on for the project.
# Same value as the frontend's VITE_NEON_AUTH_URL. The JWKS URL builds from
# this automatically (NEON_AUTH_URL + /.well-known/jwks.json). Set
# NEON_AUTH_JWKS_URL directly instead if you need to override it.
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=

# Anthropic API key used for the server-managed free-credit generation path
# (POST /api/generation-jobs with generation_mode=free_credit).
# Get one from console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional model tier overrides:
# COURSE_GEN_MODEL_<PROVIDER>_<TIER>=<model-name>
# Example:
# COURSE_GEN_MODEL_ANTHROPIC_STANDARD=claude-sonnet-5

# Transactional email for the feedback channel (Resend). Leave RESEND_API_KEY
# blank in development: submissions are still stored, and the send is skipped
# with a log line instead of failing. The sending domain must be verified in
# Resend before FEEDBACK_FROM_EMAIL will deliver.
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=builp <noreply@kdnth.co>
# Where course problem reports go.
SUPPORT_EMAIL=support@kdnth.co
# Where general contact messages go.
CONTACT_EMAIL=hello@kdnth.co
# Used to build course links inside report emails.
APP_BASE_URL=https://builp.kdnth.co
