# Copy this file to .env.local and fill in the real value from the Neon
# console (Neon Auth quickstart).
VITE_NEON_AUTH_URL=https://your-project.neon.tech/auth

# Base URL of the backend API (see backend/README.md). Use the backend
# origin only (for example http://localhost:8000), not a path like /api.
VITE_API_URL=http://localhost:8000
